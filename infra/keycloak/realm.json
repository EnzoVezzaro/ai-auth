{
  "realm": "ai-auth-dev",
  "enabled": true,
  "clients": [
    {
      "clientId": "ai-auth-test",
      "name": "AI Auth local integration test client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ai-auth-test-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "AI Auth API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ai-auth-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "AI Auth test agent name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "agent_name",
            "claim.value": "Keycloak Integration Agent",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "AI Auth test category",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "agent_category",
            "claim.value": "simulated_test_client",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
