{
  "name": "@enzovezzaro/ai-auth-mcp",
  "version": "0.3.9",
  "description": "Locally approved AI Auth wallet actions exposed over MCP stdio",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "cli-args.js",
    "connect-input.js",
    "approval.js",
    "bridge.js",
    "code-mode-worker.js",
    "http.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@enzovezzaro/ai-auth-agent": "file:../agent",
    "@enzovezzaro/ai-auth-wallet": "file:../..",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "prepack": "node ../../scripts/pin-local-deps.mjs pin",
    "postpack": "node ../../scripts/pin-local-deps.mjs restore"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "MIT",
  "bin": {
    "ai-auth-mcp": "./cli.js"
  }
}
