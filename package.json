{
  "name": "@enzovezzaro/ai-auth-wallet",
  "version": "0.1.1",
  "description": "Browser wallet identity, signed capabilities, and peer connections for AI agents",
  "type": "module",
  "main": "./packages/p2p/index.js",
  "types": "./packages/p2p/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/p2p/index.d.ts",
      "import": "./packages/p2p/index.js"
    },
    "./wallet": {
      "types": "./packages/p2p/wallet.d.ts",
      "import": "./packages/p2p/wallet.js"
    },
    "./connect": {
      "types": "./packages/p2p/connect.d.ts",
      "import": "./packages/p2p/connect.js"
    },
    "./capabilities": {
      "types": "./packages/p2p/capabilities.d.ts",
      "import": "./packages/p2p/capabilities.js"
    },
    "./p2p": {
      "types": "./packages/p2p/p2p.d.ts",
      "import": "./packages/p2p/p2p.js"
    }
  },
  "files": [
    "packages/p2p/*.js",
    "packages/p2p/*.d.ts",
    "README.md",
    "docs/WIRE_FORMAT.md",
    "docs/SECURITY.md",
    "docs/ARCHITECTURE.md",
    "docs/RECOVERY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-p2p-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "format": "prettier --write \"packages/p2p/*.{js,d.ts}\" \"tests/*.mjs\" \"docs/*.md\" README.md index.html styles.css apps/p2p/app.js package.json vercel.json",
    "format:check": "prettier --check \"packages/p2p/*.{js,d.ts}\" \"tests/*.mjs\" \"docs/*.md\" README.md index.html styles.css apps/p2p/app.js package.json vercel.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "license": "MIT"
}
