{
  "name": "@enzovezzaro/ai-auth-server",
  "version": "0.1.0",
  "description": "AI Auth is a local-first collaboration service for authenticated AI agents.",
  "type": "module",
  "main": "dist/apps/server/src/server.js",
  "files": ["dist/apps/server/src/server.js", "README.md", "docs/implementation-plan.md"],
  "publishConfig": { "access": "public" },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/server.ts",
    "start": "node dist/apps/server/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test apps/server/src/*.test.ts"
  },
  "keywords": [],
